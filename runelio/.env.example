# ------------------------------------------------------------------
# Runelio — variables d'environnement (copier en .env, ne jamais committer .env)
# ------------------------------------------------------------------

# Base PostgreSQL (16+)
DATABASE_URL=postgres://runelio:motdepasse@localhost:5432/runelio

# URL publique du site (sans / final). En production : https://runelio.fr
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret Better Auth (≥ 32 caractères aléatoires) : openssl rand -base64 48
# BETTER_AUTH_SECRET=

# Mot de passe de la base PostgreSQL (docker compose) : openssl rand -hex 24
# POSTGRES_PASSWORD=

# --- Whop (paiement et abonnement) --------------------------------
# Clé API de l'entreprise (dashboard Whop > Developer). Permissions nécessaires :
# création de checkout configurations, lecture/gestion des memberships, lecture des plans et paiements.
WHOP_API_KEY=
# Identifiant de l'entreprise (biz_…)
WHOP_COMPANY_ID=
# Plan récurrent 19,99 EUR tous les 30 jours (plan_…)
WHOP_PLAN_ID=
# Secret du webhook (ws_…), à coller tel quel. URL du webhook : https://runelio.fr/api/webhooks/whop
# Événements : membership.activated, membership.deactivated, membership.cancel_at_period_end_changed,
# payment.succeeded, payment.failed, payment.pending, payment.canceled
WHOP_WEBHOOK_SECRET=
# Production : https://api.whop.com/api/v1 — bac à sable : https://sandbox-api.whop.com/api/v1
WHOP_API_BASE_URL=https://api.whop.com/api/v1

# --- E-mails transactionnels (prestataire SMTP à choisir) ---------
# Sans SMTP_HOST : les e-mails sont affichés dans la console (dev uniquement ; en production, erreur).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM="Runelio <no-reply@runelio.fr>"

# --- Tâche planifiée (rappels e-mail la veille des séances) ---------
# Secret partagé avec le service `cron` (≥ 24 caractères) : openssl rand -hex 24
# CRON_SECRET=

# --- Fonctionnalités soumises à vérification -----------------------
# Factures émises par l'éditeur (numérotation continue). N'activer qu'après avoir confirmé
# que Whop n'agit pas comme vendeur (« merchant of record ») et validé les mentions obligatoires.
INVOICES_ENABLED=false
# Tirages au sort « Cadeaux du mois ». Laisser à false tant que le règlement n'est pas validé et publié.
GIVEAWAYS_ENABLED=false
