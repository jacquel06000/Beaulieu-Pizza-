# ------------------------------------------------------------------
# Runelio — variables d'environnement (copier en .env, ne jamais committer .env)
# ------------------------------------------------------------------

# Base PostgreSQL (16+)
DATABASE_URL=postgres://runelio:motdepasse@localhost:5432/runelio

# URL publique du site (sans / final). En production : https://runelio.fr
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret Better Auth (≥ 32 caractères aléatoires) : openssl rand -base64 48
# BETTER_AUTH_SECRET=

# Mot de passe de la base PostgreSQL (docker compose) : openssl rand -hex 24
# POSTGRES_PASSWORD=

# --- Stripe (paiement et abonnement) ------------------------------
# Clé secrète (Dashboard Stripe > Développeurs > Clés API). sk_test_… pour les essais, sk_live_… en production.
# Ne jamais la mettre ailleurs que dans ce fichier sur le serveur.
STRIPE_SECRET_KEY=
# Prix récurrent 19,99 EUR, facturé chaque mois, sans essai (price_…)
STRIPE_PRICE_ID=
# Secret du webhook (whsec_…). URL du webhook : https://runelio.fr/api/webhooks/stripe
# Événements : checkout.session.completed, checkout.session.expired,
# customer.subscription.created, customer.subscription.updated, customer.subscription.deleted,
# customer.subscription.paused, customer.subscription.resumed,
# invoice.paid, invoice.payment_failed, invoice.payment_action_required
STRIPE_WEBHOOK_SECRET=

# --- E-mails transactionnels (prestataire SMTP à choisir) ---------
# Sans SMTP_HOST : les e-mails sont affichés dans la console (dev uniquement ; en production, erreur).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM="Runelio <no-reply@runelio.fr>"

# --- Tâche planifiée (rappels e-mail la veille des séances) ---------
# Secret partagé avec le service `cron` (≥ 24 caractères) : openssl rand -hex 24
# CRON_SECRET=

# --- Fonctionnalités soumises à vérification -----------------------
# Factures générées par le site (numérotation RUN-AAAA-NNNNN). Laisser à false si vous utilisez
# les factures Stripe (recommandé), pour ne pas avoir deux séries de numérotation.
INVOICES_ENABLED=false
# Tirages au sort « Cadeaux du mois ». Laisser à false tant que le règlement n'est pas validé et publié.
GIVEAWAYS_ENABLED=false
